{
  "expo": {
    "name": "إدارة التمويل",
    "slug": "finance-mobile",
    "scheme": "finance-mobile",
    "version": "1.0.7",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.example.financemobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "bundleIdentifier": "sa.pm.finance",
      "buildNumber": "14",
      "infoPlist": {
        "NSFaceIDUsageDescription": "يستخدم تطبيق التمويل بصمة الوجه لتسجيل الدخول السريع بعد أول دخول بكلمة المرور."
      }
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم تطبيق التمويل بصمة الوجه لتسجيل الدخول السريع بعد أول دخول بكلمة المرور."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "11f1653b-2335-4f9d-82db-b5534fcb2624"
      }
    },
    "icon": "./assets/icon.png"
  }
}
